# Netlify / Cloudflare Pages HTTP Headers

# Root and Homepage RFC 8288 Link Headers
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </.well-known/ai-catalog.json>; rel="ai-catalog", </docs/api.html>; rel="service-doc", </docs/openapi.json>; rel="service-desc", </.well-known/mcp/server-card.json>; rel="mcp-server-card", </.well-known/agent-skills/index.json>; rel="agent-skills", </auth.md>; rel="author-md", </index.md>; rel="alternate"; type="text/markdown"
  Access-Control-Allow-Origin: *

/index.html
  Link: </.well-known/api-catalog>; rel="api-catalog", </.well-known/ai-catalog.json>; rel="ai-catalog", </docs/api.html>; rel="service-doc", </docs/openapi.json>; rel="service-desc", </.well-known/mcp/server-card.json>; rel="mcp-server-card", </.well-known/agent-skills/index.json>; rel="agent-skills", </auth.md>; rel="author-md", </index.md>; rel="alternate"; type="text/markdown"
  Access-Control-Allow-Origin: *

# Markdown for Agents
/index.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  x-markdown-tokens: 1450

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

# RFC 9727 API Catalog
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/api-catalog.json
  Content-Type: application/linkset+json; charset=utf-8
  Access-Control-Allow-Origin: *

# Agentic Resource Discovery & MCP
/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/openid-configuration
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
